{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	@stripe_webhook path /billing/webhook
	handle @stripe_webhook {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8080
	}

	@backend path /auth /auth/* /billing /billing/* /videos /videos/* /history /history/* /static/* /health
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

:8081 {
	@google_oauth_certs path /oauth2/v1/certs
	handle @google_oauth_certs {
		reverse_proxy https://www.googleapis.com {
			header_up Host www.googleapis.com
		}
	}

	respond 404
}
