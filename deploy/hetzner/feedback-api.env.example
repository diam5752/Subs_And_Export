# Copy to SUBFRAME_FEEDBACK_API_ENV_FILE with mode 0600. Only the public API
# receives these signing keys; never reuse SMTP, provider, or database secrets.
GSP_FEEDBACK_HASH_SECRET=replace-with-at-least-32-random-characters
GSP_DOWNLOAD_GRANT_SECRET=replace-with-a-different-at-least-32-byte-random-secret
