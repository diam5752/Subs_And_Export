# Copy to SUBFRAME_FEEDBACK_WORKER_ENV_FILE with mode 0600. This exact bundle is
# loaded only by the isolated worker and contains no feedback HMAC/provider keys.
GSP_DATABASE_URL=postgresql+psycopg://subframe:replace-with-url-encoded-password@db:5432/subframe
GSP_FEEDBACK_NOTIFICATION_TO=owner@example.com
GSP_FEEDBACK_MAIL_FROM="GSUBS <support@example.com>"
GSP_FEEDBACK_SMTP_HOST=smtp.example.com
GSP_FEEDBACK_SMTP_PORT=587
GSP_FEEDBACK_SMTP_STARTTLS=1
GSP_FEEDBACK_SMTP_USERNAME=replace-with-smtp-user
GSP_FEEDBACK_SMTP_PASSWORD=replace-with-smtp-password
GSP_FEEDBACK_SMTP_TIMEOUT_SECONDS=15
GSP_FEEDBACK_WORKER_POLL_SECONDS=5
GSP_FEEDBACK_WORKER_BATCH_SIZE=10
