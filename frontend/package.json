{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "lint:cognitive": "eslint --config eslint.cognitive.config.mjs . --quiet",
    "lint:dead-code": "knip",
    "analyze:duplicates": "jscpd --config ../.jscpd.json --silent --no-tips ..",
    "test": "jest",
    "test:coverage": "jest --coverage --watchAll=false",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "7.83.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-sonarjs": "4.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jscpd": "5.1.0",
    "knip": "6.40.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@next/eslint-plugin-next@16.3.6": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "brace-expansion@1.x": "1.1.21",
    "brace-expansion@2.x": "2.1.7",
    "brace-expansion@5.x": "5.0.12",
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
